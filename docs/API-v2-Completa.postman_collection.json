  "components": {
    "schemas": {
      "ClienteRequestDTO": {
        "required": [
          "nome",
          "email",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefone": {
            "$ref": "#/components/schemas/TelefoneDTO"
          },
          "endereco": {
            "$ref": "#/components/schemas/EnderecoDTO"
          },
          "veiculos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CriarUsuarioRequestDTO": {
        "required": [
          "nome",
          "email",
          "senha",
          "perfil"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "minLength": 8,
            "type": "string"
          },
          "perfil": {
            "$ref": "#/components/schemas/EPerfilUsuario"
          }
        }
      },
      "DiagnosticoRequestDTO": {
        "type": "object",
        "properties": {
          "servicos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrdemServicoServicoRequestDTO"
            }
          },
          "pecas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrdemServicoPecaRequestDTO"
            }
          },
          "insumos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrdemServicoInsumoRequestDTO"
            }
          },
          "observacao": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EnderecoDTO": {
        "type": "object",
        "properties": {
          "logradouro": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "complemento": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "uf": {
            "type": "string"
          }
        }
      },
      "EPerfilUsuario": {
        "type": "integer"
      },
      "EstoqueRequestDTO": {
